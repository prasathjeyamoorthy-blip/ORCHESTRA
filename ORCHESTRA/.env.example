# ── Copy this to .env on your EC2 instance and fill in the values ────────────

# OpenRouter (LLM)
OPEN_ROUTER_API_KEY=

# Qdrant (Vector DB)
QDRANT_URL=
QDRANT_API_KEY=

# NVIDIA API Keys
NVIDIA_API_KEY=
NVIDIA_API_KEY1=
NVIDIA_API_KEY2=
NVIDIA_API_KEY3=
NVIDIA_META_11B=

# Groq API Keys
GROQ_API_KEY=
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=
GROQ_API_KEY4=
GROQ_API_KEY5=
GROQ_API_KEY6=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OTP Service (Message Central)
MESSAGE_CENTRAL_AUTH_TOKEN=
MESSAGE_CENTRAL_CUSTOMER_ID=

# Encryption
ENCRYPTION_SECRET_KEY=

# CORS — set to your Amplify domain after deploy
ALLOWED_ORIGINS=https://YOUR_AMPLIFY_DOMAIN.amplifyapp.com,http://localhost:5173

# Self-Declaration PDF (optional — leave blank to use bundled file)
S3_DECLARATION_URL=
