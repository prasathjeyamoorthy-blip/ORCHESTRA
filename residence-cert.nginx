map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    server_name residence-cert.duckdns.org;

    ssl_certificate /etc/letsencrypt/live/residence-cert.duckdns.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/residence-cert.duckdns.org/privkey.pem;

    # WebSocket — ^~ gives it highest prefix priority
    location ^~ /ws/ {
        proxy_pass http://localhost:8001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # DocumentUploadAgent endpoints
    location ~ ^/(extract|process-all|verify|upload|download-declaration|upload-signed-declaration|upload-encrypted-doc|clear-cache) {
        proxy_pass http://localhost:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin $http_origin;
        client_max_body_size 20M;
    }

    # Everything else goes to ORCHESTRA backend
    location / {
        proxy_pass http://localhost:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Origin $http_origin;
    }
}

server {
    listen 80;
    server_name residence-cert.duckdns.org;
    return 301 https://$host$request_uri;
}
