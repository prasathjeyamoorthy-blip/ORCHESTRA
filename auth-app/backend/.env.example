# ═══════════════════════════════════════════════════════════════════════════
# Node.js Backend Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your actual credentials
# All variables marked as REQUIRED must be set for the application to start

# ── Supabase (REQUIRED) ────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Upstash Redis (REQUIRED) ───────────────────────────────────────────────
# Get these from: https://console.upstash.com/redis
# Used for: session cache, profile cache, agent memory, long-term memory
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# ── Server Configuration ───────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── RAG Agent URL ──────────────────────────────────────────────────────────
# URL where the Python RAG agent is running
RAG_URL=http://localhost:8000

# ── Message Central OTP (Optional) ─────────────────────────────────────────
# Only required if using OTP functionality
MC_CUSTOMER_ID=your_customer_id
MC_PASSWORD_B64=your_base64_encoded_password

# ═══════════════════════════════════════════════════════════════════════════
# CRITICAL NOTES:
# ═══════════════════════════════════════════════════════════════════════════
# 1. NO LOCAL FALLBACKS: This application REQUIRES Upstash Redis and Supabase.
#    If credentials are missing or invalid, the server will exit immediately.
#
# 2. MEMORY ISOLATION: All memory is isolated per user_id to prevent cross-user
#    data leakage. Redis keys are scoped as: chat:{userId}:{sessionId}
#
# 3. SECURITY: Never commit .env files to version control. Keep credentials secret.
#
# 4. STARTUP VALIDATION: The server validates all REQUIRED credentials on startup
#    and will exit with error messages if any are missing or invalid.
